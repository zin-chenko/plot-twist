# Non-secret deployment settings only. Real secrets go into ./secrets/, outside Git.
APP_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
AUTH_ISSUER=https://api.example.com
AUTH_REDIRECT_URI=http://127.0.0.1:18080/callback
# Optional Angular UI, with an exact registered HTTPS callback (no wildcard).
AUTH_BROWSER_REDIRECT_URI=https://app.example.com/auth/callback
# Browser access lifetime and issuer session idle timeout. Range: 1m to 12h.
AUTH_SESSION_DURATION=4h
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-mail-provider-username
MAIL_FROM=noreply@example.com
S3_REGION=eu-central-1
S3_BUCKET=replace-with-your-private-bucket
# Empty means AWS S3; use an HTTPS endpoint for another S3 provider.
S3_ENDPOINT=
S3_PATH_STYLE=false
TRACING_ENABLED=false

# Pin the full Hugging Face model commit SHA for production after the first verified download.
EMBEDDING_MODEL_REVISION=replace-with-full-model-commit-sha
