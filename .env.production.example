# Non-secret deployment settings only. Real secrets go into ./secrets/, outside Git.
APP_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
AUTH_ISSUER=https://api.example.com
AUTH_REDIRECT_URI=http://127.0.0.1:18080/callback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-mail-provider-username
MAIL_FROM=noreply@example.com
S3_REGION=eu-central-1
S3_BUCKET=replace-with-your-private-bucket
# Empty means AWS S3; use an HTTPS endpoint for another S3 provider.
S3_ENDPOINT=
S3_PATH_STYLE=false
TRACING_ENABLED=false
